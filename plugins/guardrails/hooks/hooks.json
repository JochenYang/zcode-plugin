{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/guard-bash.sh"
            ],
            "timeoutMs": 5000,
            "statusMessage": "Checking command against guardrails"
          }
        ]
      },
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/guard-write.sh"
            ],
            "timeoutMs": 5000,
            "statusMessage": "Scanning write for credentials"
          }
        ]
      }
    ]
  }
}
