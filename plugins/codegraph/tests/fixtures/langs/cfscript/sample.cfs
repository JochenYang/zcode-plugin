import "lib.cfc";
import components.*;

component displayname="Vault" hint="Keeps per-user balances" accessors="true" {

    property name="fee" type="numeric" default=0.05;

    public Vault function init(any logger = new Lib()) {
        variables.logger = logger;
        return this;
    }

    // Credits an amount for a user.
    public numeric function deposit(required string owner, numeric amount = 1) {
        variables.total += arguments.amount;
        writeDump(owner);
        this.log("deposit", amount);
        return new Lib().format(variables.total);
    }

    private numeric function formatAmount(numeric value) {
        return dollarFormat(arguments.value);
    }
}
