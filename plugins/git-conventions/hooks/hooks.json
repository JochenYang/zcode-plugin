{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/check-commit.mjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "Checking the commit message against the convention"
          }
        ]
      }
    ]
  }
}
